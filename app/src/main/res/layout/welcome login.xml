<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E1A63"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- School Logo -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/img"
            android:contentDescription="School Logo"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <!-- School Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANILA CATHEDRAL SCHOOL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- App Tagline / Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEARCH IT!"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="32dp" />

        <!-- Login Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardElevation="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- Left Column: Form Inputs -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back!"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Email/Phone Field Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email or Phone Number"
                        android:textColor="#CCCCCC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <!-- Email/Phone Input -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="#121212"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="12dp" />

                    <!-- Password Field Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="#CCCCCC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <!-- Password Input -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="#121212"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:inputType="textPassword"
                        android:layout_marginBottom="4dp" />

                    <!-- Forgot Password Link -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot your password?"
                        android:textColor="#6A5ACD"
                        android:textSize="9.5sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Log In Button -->
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Log In"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#7856FF"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Register Footer Link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need an account? "
                            android:textColor="#AAAAAA"
                            android:textSize="9.5sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Register"
                            android:textColor="#7856FF"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Right Column: QR Code Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- QR Code Image -->
                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/img"
                        android:scaleType="centerCrop"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:contentDescription="QR Code"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log in with Qr Code"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan this with your mobile app to instantly log in."
                        android:textColor="#AAAAAA"
                        android:textSize="8sp"
                        android:gravity="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Or, sign in with passkey"
                        android:textColor="#7856FF"
                        android:textSize="8.5sp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>